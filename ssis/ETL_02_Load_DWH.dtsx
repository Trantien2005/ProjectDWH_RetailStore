        <DTS:Executable
          DTS:refId="Package\SEQ_Transform_To_Dim\SQL_Ensure_DimDate"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{c51406e7-6d2f-4788-9730-6930a64c37bd}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Ensure_DimDate"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{62961672-B882-4CFB-81C6-D82054244482}"
              SQLTask:SqlStatementSource="DECLARE @StartDate DATE = '2019-01-01';&#xA;DECLARE @EndDate   DATE = '2030-12-31';&#xA;&#xA;WHILE @StartDate &lt;= @EndDate&#xA;BEGIN&#xA;    INSERT INTO DimDate&#xA;    (&#xA;        date_key,&#xA;        full_date,&#xA;        day_of_week,&#xA;        month,&#xA;        quarter,&#xA;        year,&#xA;        is_weekend,&#xA;        season&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        CAST(CONVERT(VARCHAR(8), @StartDate, 112) AS INT),&#xA;        @StartDate,&#xA;        DATENAME(WEEKDAY, @StartDate),&#xA;        MONTH(@StartDate),&#xA;        DATEPART(QUARTER, @StartDate),&#xA;        YEAR(@StartDate),&#xA;        CASE &#xA;            WHEN DATENAME(WEEKDAY, @StartDate) IN ('Saturday','Sunday') THEN 1&#xA;            ELSE 0&#xA;        END,&#xA;        CASE&#xA;            WHEN MONTH(@StartDate) IN (12,1,2) THEN 'Winter'&#xA;            WHEN MONTH(@StartDate) IN (3,4,5) THEN 'Spring'&#xA;            WHEN MONTH(@StartDate) IN (6,7,8) THEN 'Summer'&#xA;            ELSE 'Autumn'&#xA;        END&#xA;    );&#xA;&#xA;    SET @StartDate = DATEADD(DAY,1,@StartDate);&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
