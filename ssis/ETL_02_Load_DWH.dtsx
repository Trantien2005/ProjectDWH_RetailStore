        <DTS:Executable
          DTS:refId="Package\SEQ_Transform_To_Dim\EXE_Load_DimTime"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{39BB8815-F97F-419B-BB97-2F867D60FE58}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="EXE_Load_DimTime"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{62961672-B882-4CFB-81C6-D82054244482}"
              SQLTask:SqlStatementSource="TRUNCATE TABLE DimTime;&#xA;&#xA;DECLARE @hour INT = 0;&#xA;DECLARE @minute INT;&#xA;DECLARE @time_key INT;&#xA;DECLARE @time_string NVARCHAR(5);&#xA;DECLARE @is_peak BIT;&#xA;&#xA;WHILE @hour &lt; 24&#xA;BEGIN&#xA;    SET @minute = 0;&#xA;&#xA;    WHILE @minute &lt; 60&#xA;    BEGIN&#xA;        SET @time_key = @hour * 100 + @minute;&#xA;&#xA;        SET @time_string =&#xA;            RIGHT('0' + CAST(@hour AS VARCHAR(2)),2) + ':' +&#xA;            RIGHT('0' + CAST(@minute AS VARCHAR(2)),2);&#xA;&#xA;        SET @is_peak =&#xA;            CASE&#xA;                WHEN (@hour &gt;= 10 AND @hour &lt;= 13)&#xA;                  OR (@hour &gt;= 17 AND @hour &lt;= 20)&#xA;                THEN 1&#xA;                ELSE 0&#xA;            END;&#xA;&#xA;        INSERT INTO DimTime(time_key, time_string, hour_of_day, minute, is_peak_hour)&#xA;        VALUES(@time_key, @time_string, @hour, @minute, @is_peak);&#xA;&#xA;        SET @minute = @minute + 1;&#xA;    END&#xA;&#xA;    SET @hour = @hour + 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\SEQ_Transform_To_Dim\PKG_Load_DimCustomer_SCD2"
